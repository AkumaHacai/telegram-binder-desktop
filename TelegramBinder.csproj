<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Telegram Binder</AssemblyName>
    <RootNamespace>TelegramBinder</RootNamespace>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\TelegramBinder.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <EmbeddedResource Include="Web\*" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>
</Project>
